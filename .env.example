# Local: only TYPESAFE_API_KEY is required for Jev. Native Windows inference uses the sibling models workspace.
# All values below are examples, not working credentials. Leave unused service variables unset.
TYPESAFE_API_KEY=replace_with_typesafe_key
# Public inference requires all shared protection settings.
UPSTASH_REDIS_REST_URL=https://replace-with-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token
SESSION_SECRET=replace_with_at_least_32_random_bytes
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_public_widget_site_key
# Daily UTC request reservations shared across all Jev visitors. 0 disables public Jev calls.
PUBLIC_DAILY_JEV_CALLS=1000
# Optional hosted n-tuple evaluator. Keep both server-side. Leave unset for local native inference.
NTUPLE_SERVICE_URL=https://ntuple.example.com
NTUPLE_SERVICE_SECRET=replace_with_service_secret_matching_oracle_vm
