{
  "name": "jev-2048",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start --hostname 127.0.0.1 --port 2048",
    "test": "tsx --test test/engine.test.js test/server.test.js test/arcade.test.ts test/policy.test.js test/search.test.js test/lab.test.ts",
    "test:browser": "node test/lab-browser.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 2048",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "legacy": "node server.js",
    "evaluate:pilot": "node test/evaluate-complete.mjs pilot",
    "evaluate:complete": "node test/evaluate-complete.mjs holdout",
    "evaluate:search": "node test/evaluate-search.mjs holdout",
    "test:browser:legacy": "node test/arcade-browser.mjs",
    "evaluate:lab:pilot": "node test/evaluate-lab.mjs pilot",
    "evaluate:lab": "node test/evaluate-lab.mjs evaluation",
    "evaluate": "node study/run.mjs",
    "test:study": "node --test study/study.test.mjs study/report.test.mjs",
    "test:release": "tsx --test test/analytics.test.ts test/request-path.test.ts test/play-selector.test.ts test/hosted-native.test.ts test/blind.test.ts test/ultra.test.ts test/lab.test.ts",
    "test:release:browser": "node test/ready.browser.mjs && node test/ultra-ui.browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@typesafe-ai/sdk": "^0.6.0",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  }
}
